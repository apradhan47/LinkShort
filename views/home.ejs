
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LinkShort | Dashboard</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-light: #eff6ff;
            --background: #f8fafc;
            --surface: #ffffff;
            --text: #172033;
            --muted: #64748b;
            --border: #e8edf4;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--background);
            color: var(--text);
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */

        .sidebar {
            width: 245px;
            background: white;
            border-right: 1px solid var(--border);
            padding: 28px 18px;
            flex-shrink: 0;
        }

        .brand {
            font-size: 25px;
            font-weight: 800;
            color: var(--primary);
            padding: 0 12px;
            margin-bottom: 45px;
        }

        .nav-label {
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            padding: 0 12px;
            margin-bottom: 12px;
        }

        .nav-link {
            display: block;
            padding: 12px;
            margin-bottom: 7px;
            color: var(--muted);
            text-decoration: none;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 500;
            transition: 0.2s;
        }

        .nav-link.active {
            background: var(--primary-light);
            color: var(--primary);
            font-weight: 600;
        }

        .nav-link:hover {
            background: #f1f5f9;
            color: var(--primary);
        }

        /* Main content */

        .main {
            flex: 1;
            min-width: 0;
            padding: 38px 45px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
            gap: 15px;
        }

        .topbar h1 {
            font-size: 26px;
            font-weight: 700;
        }

        .topbar p {
            color: var(--muted);
            font-size: 13px;
            margin-top: 7px;
        }

        .profile {
            background: white;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px 15px;
            font-size: 13px;
            font-weight: 600;
        }

        /* Statistics */

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 28px;
        }

        #analytics-overview {
            scroll-margin-top: 25px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 23px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        }

        .stat-card p {
            color: var(--muted);
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 14px;
        }

        .stat-card h2 {
            font-size: 28px;
            font-weight: 700;
        }

        .stat-icon {
            color: var(--primary);
            background: var(--primary-light);
            padding: 8px 11px;
            border-radius: 8px;
            display: inline-block;
            margin-bottom: 13px;
            font-size: 12px;
            font-weight: 700;
        }

        /* Panels */

        .panel {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .panel-heading {
            margin-bottom: 22px;
        }

        .panel-heading h2 {
            font-size: 17px;
            margin-bottom: 6px;
        }

        .panel-heading p {
            font-size: 13px;
            color: var(--muted);
        }

        .chart-container {
            position: relative;
            width: 100%;
            height: 300px;
        }

        .qr-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 18px;
        }

        .qr-card {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 18px;
            background: white;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
            cursor: pointer;
        }

        .qr-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.10);
            border-color: #bfdbfe;
        }

        .qr-preview {
            transition: transform 0.25s ease;
        }

        .qr-card:hover .qr-preview {
            transform: scale(1.04);
        }

        .qr-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .qr-download {
            display: inline-block;
            background: var(--primary);
            color: white;
            text-decoration: none;
            padding: 9px 12px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
        }

        .qr-card h3 {
            font-size: 14px;
            margin-bottom: 8px;
        }

        .qr-card p {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 15px;
            overflow-wrap: anywhere;
        }

        .qr-btn {
            display: inline-block;
            background: var(--primary-light);
            color: var(--primary);
            text-decoration: none;
            padding: 9px 12px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
        }


        /* URL form */

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 0.7fr auto;
            gap: 12px;
        }

        input {
            width: 100%;
            min-width: 0;
            padding: 13px 14px;
            border: 1px solid #dbe2ea;
            border-radius: 8px;
            outline: none;
            font-size: 13px;
            font-family: inherit;
        }

        input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px #2563eb15;
        }

        button {
            border: none;
            cursor: pointer;
            font-family: inherit;
            font-weight: 600;
        }

        .primary-btn {
            background: var(--primary);
            color: white;
            border-radius: 8px;
            padding: 13px 19px;
            font-size: 13px;
            white-space: nowrap;
            transition: 0.2s;
        }

        .primary-btn:hover {
            background: var(--primary-hover);
        }

        .expiry-section {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .expiry-section h3 {
            font-size: 14px;
            margin-bottom: 6px;
        }

        .expiry-section p {
            font-size:12px;
            color: var(--muted);
            margin-bottom: 18px;
        }

        .expiry-section label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .expiry-section select,
        .expiry-section input {
            max-width: 350px;
            display: block;
        }

        .expiry-section select {
            width: 100%;
            padding: 12px;
            border: 1px solid #dbe2ea;
            border-radius: 8px;
            background: white;
            font-family: inherit;
            font-size: 13px;
        }

        .expiry-divider {
             max-width: 350px;
             text-align: center;
             color: #94a3b8;
             font-size: 11px;
             font-weight: 600;
             margin: 16px 0;
        }

        .expiry-section small {
            display: block;
            margin-top: 9px;
            color: var(--muted);
            font-size: 11px;
        }

        /* Success and error messages */

        .success {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            padding: 16px;
            border-radius: 9px;
            margin-top: 18px;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .success a {
            color: var(--primary);
            font-weight: 600;
        }

        .error {
            color: #dc2626;
            margin-top: 15px;
            font-size: 13px;
        }

        /* Search toolbar */

        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 18px;
        }

        .toolbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .sort-select {
            padding: 11px 13px;
            border: 1px solid #dbe2ea;
            border-radius: 8px;
            background: white;
            color: #334155;
            font-family: inherit;
            font-size: 12px;
            cursor: pointer;
            outline: none;
        }
        .sort-select:focus {
            border-color: var(--primary);
        }


        .search-input {
            max-width: 350px;
            background: #f8fafc;
        }

        .search-input::placeholder {
            color: #94a3b8;
        }

        .search-count {
            color: var(--muted);
            font-size: 12px;
        }

        /* URL table */

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
        }

        th {
            text-align: left;
            padding: 14px 12px;
            font-size: 11px;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            background: #f8fafc;
        }

        td {
            padding: 17px 12px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
        }

        tbody tr:hover td {
            background: #f8fbff;
            transition: background 0.2s ease;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .short-link {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

        .short-link:hover {
            text-decoration: underline;
        }

        .original-link {
            display: block;
            max-width: 230px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--muted);
        }

        .click-count {
            display: inline-block;
            background: var(--primary-light);
            color: var(--primary);
            border-radius: 20px;
            padding: 6px 12px;
            font-weight: 600;
        }

        .expiry-status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .expiry-active {
            background: #dcfce7;
            color: #15803d;
        }

        .expiry-expired {
            background: #fee2e2;
            color: #dc2626;
        }

        .expiry-never {
            background: #f1f5f9;
            color: #64748b;
        }

        .expiry-disabled {
            background: #fff7ed;
            color: #c2410c;
        }

        .expiry-date {
            display:block;
            margin-top: 6px;
            color: #64748b;
            font-size: 11px;
        }

        /* Actions */

        .actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .action-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            font-size: 12px;
        }

        .action-link:hover {
            text-decoration: underline;
        }

        .copy-btn {
            color: var(--primary);
            background: var(--primary-light);
            border-radius: 6px;
            padding: 7px 10px;
            font-size: 12px;
            transition: 0.2s;
        }

        .copy-btn:hover {
            background: #dbeafe;
        }

        .edit-btn {
            color:#2563eb;
            background: #eff6ff;
            border-radius: 6px;
            padding: 7px 10px;
            font-size: 12px;
            transition: 0.2s;
        }

        .edit-btn:hover {
            background: #dbeafe;
        }

        .delete-btn {
            color: #dc2626;
            background: #fef2f2;
            border-radius: 6px;
            padding: 7px 10px;
            font-size: 12px;
            transition: 0.2s;
        }

        .delete-btn:hover {
            background: #fee2e2;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.05);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-box {
            width: 100%;
            max-width: 450px;
            background: white;
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15)
        }

        .modal-box h2 {
            font-size: 19px;
            margin-bottom: 8px;
        }

        .modal-box p{
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 22px;
        }

        .modal-box label{
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 9px;
        }

        .modal-actions {
            display:flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
        }

        .cancel-btn {
            background: #f1f5f9;
            color: #475569;
            border-radius: 8px;
            padding: 13px 17px;
            font-size: 13px;
        }


        .empty {
            text-align: center;
            color: #94a3b8;
            padding: 35px;
        }

        .table-footer {
            color: var(--muted);
            font-size: 12px;
            margin-top: 16px;
        }

        /* Responsive */

        @media(max-width: 1000px) {
            .main {
                padding: 30px 22px;
            }

            .sidebar {
                width: 190px;
            }

            .form-grid {
                grid-template-columns: 1fr 1fr;
            }

            .form-grid button {
                grid-column: span 2;
            }
        }

        @media(max-width: 650px) {
            .layout {
                display: block;
            }

            .sidebar {
                width: 100%;
                padding: 15px;
                border-right: none;
                border-bottom: 1px solid var(--border);
            }

             .toolbar-right {
                flex-direction: column;
                align-items: stretch;
            }

            .brand {
                margin-bottom: 15px;
                padding: 0 5px;
            }

            .nav-label {
                display: none;
            }

            .nav-link {
                display: inline-block;
                margin: 0 3px 0 0;
                padding: 9px;
                font-size: 12px;
            }

            .main {
                padding: 25px 15px;
            }

            .topbar h1 {
                font-size: 21px;
            }

            .stats {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .stat-card {
                padding: 17px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-grid button {
                grid-column: auto;
            }

            .panel {
                padding: 18px;
            }

            .profile {
                display: none;
            }

            .table-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-input {
                max-width: 100%;
            }
        }
    </style>
</head>

<body>

<div class="layout">

    <!-- Sidebar -->

    <aside class="sidebar">

        <div class="brand">LinkShort.</div>

        <div class="nav-label">WORKSPACE</div>

        <a href="/" class="nav-link active">▦ &nbsp; Overview</a>
        <a href="#url-history" class="nav-link">↗ &nbsp; My Links</a>

        <div class="nav-label" style="margin-top: 30px;">
            MANAGEMENT
        </div>

        <a href="#analytics-overview" class="nav-link"
           onclick="event.preventDefault();
           const section = document.getElementById('analytics-overview');
           const position = section.getBoundingClientRect().top + window.scrollY - 25;
           window.scrollTo({ top: position, behavior: 'smooth' });">
           ◷ &nbsp; Analytics
        </a>
        <a href="#qr-codes" class="nav-link">▧ &nbsp; QR Codes</a>

    </aside>


    <!-- Main dashboard -->

    <main class="main">

        <div class="topbar">

            <div>
                <h1>Dashboard Overview</h1>
                <p>Manage your links and track their performance.</p>
            </div>

            <div class="profile">
                LinkShort Workspace
            </div>

        </div>


        <!-- Statistics -->

        <section class="stats">

            <div class="stat-card">
                <div class="stat-icon">LINKS</div>
                <p>Total Short Links</p>
                <h2><%= urls ? urls.length : 0 %></h2>
            </div>

            <div class="stat-card">
                <div class="stat-icon">CLICKS</div>
                <p>Total Clicks</p>
                <h2><%= urls ? urls.reduce((total, url) => total + url.visitHistory.length, 0) : 0 %></h2>
            </div>

            <div class="stat-card">
                <div class="stat-icon">AVG</div>
                <p>Average Clicks per Link</p>
                <h2><%= urls && urls.length ? (urls.reduce((total, url) => total + url.visitHistory.length, 0) / urls.length).toFixed(1) : 0 %></h2>
            </div>

        </section>

        <section class="stats" id="analytics-overview">
            <div class="stat-card">
                <div class="stat-icon">ACTIVE</div>
                <p>Active Links</p>
                <h2><%= dashboardStats.activeLinks %></h2>
            </div>

            <div class="stat-card">
                <div class="stat-icon">DISABLED</div>
                <p>Disabled Links</p>
                <h2><%= dashboardStats.disabledLinks %></h2>
            </div>

            <div class="stat-card">
                <div class="stat-icon">EXPIRED</div>
                <p>Expired Links</p>
                <h2><%= dashboardStats.expiredLinks %></h2>
            </div>

        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>Click Performance Overview</h2>
                <p>Track your total link clicks over the last 7 days.</p>
            </div>

            <div class="chart-container">
                <canvas id="dashboardClicksChart"></canvas>
            </div>
        </section>
        <!-- Create URL -->

        <section class="panel">

            <div class="panel-heading">
                <h2>Create a new short link</h2>
                <p>Paste your long URL and create a shareable short link.</p>
            </div>

            <form method="POST" action="/url">

                <div class="form-grid">

                    <input
                        type="url"
                        name="url"
                        placeholder="https://example.com"
                        required
                    >

                    <input
                        type="text"
                        name="customId"
                        placeholder="Custom alias (optional)"
                    >

                    <button type="submit" class="primary-btn">
                        + Generate Link
                    </button>

                </div>

                <div class="expiry-section">

                    <h3>Link Expiration</h3>

                    <p>Choose how long your shortened URL should remain active.</p>

                    <label for="expiryDuration">Choose a Duration</label>

                    <select name="expiryDuration" id="expiryDuration">
                        <option value="">Never expires</option>
                        <option value="1">1 Day</option>
                        <option value="7">7 Days</option>
                        <option value="30">30 Days</option>
                        <option value="90">90 Days</option>
                    </select>

                    <div class="expiry-divider">OR</div>

                    <label for="expiryDate">Select a specific expiry date</label>

                    <input
                       type="date"
                       name="expiryDate"
                       id="expiryDate"
                    >

                    <input
                        type="hidden"
                        name="timezoneOffset"
                        id="timezoneOffset"
                    >

                    <small>Leave both options empty if you don't want the link to expire.</small>
                </div>

            </form>


            <% if (locals.error) { %>
                <p class="error"><%= error %></p>
            <% } %>


            <% if (locals.id) { %>

                <div class="success">

                    <strong>Your shortened URL:</strong><br><br>

                    <a href="/<%= id %>" target="_blank">
                        <%= `${typeof host !== 'undefined' ? host : 'http://localhost:8001'}/${id}` %>
                    </a>

                    <button
                        type="button"
                        class="copy-btn"
                        onclick="copyURL('<%= id %>')">
                        Copy
                    </button>

                </div>

            <% } %>

        </section>


        <!-- URL History -->

        <section class="panel" id="url-history">

            <div class="panel-heading">
                <h2>Your Links</h2>
                <p>View and manage all your shortened URLs.</p>
            </div>

            <!-- Search -->

            <div class="table-toolbar">

                <input
                    type="text"
                    id="searchLinks"
                    class="search-input"
                    placeholder="Search by short URL or destination..."
                    aria-label="Search shortened URLs"
                >

                <div class="toolbar-right">
                    <select id="sortLinks" class="sort-select">
                        <option value="recent">Recently Created</option>
                        <option value="most">Most Clicked</option>
                        <option value="least">Least Clicked</option>
                         <option value="alphabetical">Alphabetical (A-Z)</option>
                    </select>
                    <span class="search-count" id="searchCount">
                        Showing <%= urls ? urls.length : 0 %> links
                    </span>
                </div>

            </div>


            <!-- Table -->

            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Short Link</th>
                            <th>Destination</th>
                            <th>Total Clicks</th>
                            <th>Expiry / Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="urlTableBody">

                        <% if (urls && urls.length > 0) { %>

                            <% urls.forEach((url, index) => { %>

                                <tr class="url-row" data-created-at="<%= url.createdAt ? new Date(url.createdAt).getTime() : 0 %>">

                                    <td><%= index + 1 %></td>

                                    <td>
                                        <a
                                            class="short-link"
                                            href="/<%= url.shortId %>"
                                            target="_blank">
                                            <%= url.shortId %>
                                        </a>
                                    </td>

                                    <td>
                                        <span
                                            class="original-link"
                                            title="<%= url.redirectURL %>">
                                            <%= url.redirectURL %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="click-count">
                                            <%= url.visitHistory.length %>
                                        </span>
                                    </td>

                                    <td>
                                        <% if (url.expiresAt && new Date(url.expiresAt) <= new Date()) { %>
                                            <span class="expiry-status expiry-expired">
                                                Expired
                                            </span>

                                            <%} else if (url.isActive === false) {%>

                                                <span class="expiry-status expiry-disabled">
                                                    Disabled
                                                </span>
                                            <%}  else if (url.expiresAt) {%>
                                                <span class ="expiry-status expiry-active">
                                                    Active
                                                </span>

                                            <% } else { %>
                                                 <span class="expiry-status expiry-never">
                                                    Never expires
                                                 </span>
                                            <% } %>

                                            <% if (url.expiresAt) { %>
                                                <span class="expiry-date">
                                                    <%=new Date(url.expiresAt).toLocaleDateString('en-IN',{
                                                        day: '2-digit',
                                                        month: 'short',
                                                        year: 'numeric'
                                                    }) %>
                                                </span>
                                            <%}%>
                                    </td>

                                    <td>

                                        <div class="actions">

                                            <form
                                               method="POST"
                                               action="/url/toggle/<%= url.shortId %>"
                                               onsubmit="return confirm('Are you sure you want to change this link status?');">

                                               <button
                                                   type="submit"
                                                   class="edit-btn">
                                                   <%= url.isActive === false ? 'Activate' : 'Deactivate' %>
                                                </button>
                                            </form>

                                            <button
                                                type="button"
                                                class="copy-btn"
                                                onclick="copyURL('<%= url.shortId %>')">
                                                Copy
                                            </button>

                                            <button
                                                type="button"
                                                class="edit-btn"
                                                onclick="openEditModal(
                                                    '<%= url.shortId%>',
                                                    '<%= encodeURIComponent(url.redirectURL)%>'
                                                )">
                                                Edit
                                            </button>

                                            <button
                                                type="button"
                                                class="edit-btn"
                                                onclick="openExpirationModal(
                                                    '<%= url.shortId %>',
                                                    '<%= url.expiresAt ? new Date(url.expiresAt).toISOString() : "" %>'
                                                )">
                                                 Expiration
                                            </button>

                                            <a
                                                class="action-link"
                                                href="/url/analytics/<%= url.shortId %>">
                                                Analytics
                                            </a>

                                            <a
                                                class="action-link"
                                                href="/url/qrcode/<%= url.shortId %>">
                                                QR Code
                                            </a>

                                            <form
                                                method="POST"
                                                action="/url/delete/<%= url.shortId %>"
                                                onsubmit="return confirm('Are you sure you want to delete this URL?');">

                                                <button
                                                    type="submit"
                                                    class="delete-btn">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>
                                <td colspan="6" class="empty">
                                    No URLs generated yet. Create your first short link above!
                                </td>
                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

            <div class="table-footer" id="tableFooter">
                Showing <%= urls ? urls.length : 0 %> shortened links
            </div>

            <p class="empty" id="noSearchResults" style="display: none;">
                No matching URLs found.
            </p>

        </section>

        <section class="panel" id="qr-codes">
            <div class="panel-heading">
                <h2>Your QR Codes</h2>
                <p>View and download QR codes for your shortened links.</p>
            </div>
            <div class="qr-grid">
                <% if (urls && urls.length > 0) { %>
                    <% urls.forEach(url => { %>
                        <div class="qr-card">
                            <h3><%= url.shortId %></h3>

                            <p><%=url.redirectURL%></p>

                            <img
                                src="<%=url.qrCode%>"
                                alt="QR Code for <%=url.shortId %>"
                                class="qr-preview"
                            >

                            <div class="qr-actions">
                                <a
                                  href="<%= url.qrCode %>"
                                  download="LinkShort-<%= url.shortId %>.png"
                                  class="qr-download">
                                  Download QR
                                </a>

                                <a 
                                   href = "/url/qrcode/<%= url.shortId%>"
                                   class="qr-btn">
                                   View QR                                
                                </a>
                            </div>
                            
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="empty">
                        No shortened URLs available. Create a link first!
                    </p>
                <% } %>
            </div>
        </section>

    </main>

</div>


<!-- Edit URL Modal -->
<div id="editModal" class="modal-overlay">

    <div class="modal-box">

        <h2>Edit Destination URL</h2>

        <p>Update where your shortened URL redirects visitors.</p>

        <form id="editForm" method="POST">

            <label for="editDestination">New Destination URL</label>

            <input
                type="url"
                id="editDestination"
                name="url"
                placeholder="https://example.com"
                required
            >

            <div class="modal-actions">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeEditModal()">
                    Cancel
                </button>

                <button
                    type="submit"
                    class="primary-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


<!-- Edit Expiration Modal -->
<div id="expirationModal" class="modal-overlay">

    <div class="modal-box">

        <h2>Edit Link Expiration</h2>

        <p>Change when this shortened URL should expire.</p>

        <form id="expirationForm" method="POST">

            <label for="editExpiryDuration">Choose a Duration</label>

            <select
                name="expiryDuration"
                id="editExpiryDuration"
                style="width: 100%; padding: 12px; border: 1px solid #dbe2ea; border-radius: 8px; background: white; font-family: inherit; margin-bottom: 18px;">

                <option value="">No preset duration</option>
                <option value="1">1 Day</option>
                <option value="7">7 Days</option>
                <option value="30">30 Days</option>
                <option value="90">90 Days</option>

            </select>

            <label for="editExpiryDate">Or select a specific expiry date</label>

            <input
                type="date"
                name="expiryDate"
                id="editExpiryDate"
            >

            <input
                type="hidden"
                name="timezoneOffset"
                id="editTimezoneOffset"
            >

            <p style="margin-top: 12px; margin-bottom: 0;">
                Leave both options empty to make the link never expire.
            </p>

            <div class="modal-actions">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeExpirationModal()">
                    Cancel
                </button>

                <button
                    type="submit"
                    class="primary-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>

    // Copy shortened URL

    async function copyURL(shortId) {

        const shortURL = `${window.location.origin}/${shortId}`;

        try {

            await navigator.clipboard.writeText(shortURL);
            alert("Short URL copied successfully!");

        } catch (error) {

            alert("Unable to copy URL. Please copy it manually: " + shortURL);

        }

    }
    document.getElementById("timezoneOffset").value =new Date().getTimezoneOffset();
    const expiryDuration = document.getElementById("expiryDuration");
    const expiryDate = document.getElementById("expiryDate");

    expiryDuration.addEventListener("change", function () {
        if (this.value) {
            expiryDate.value = "";
        }
    });

    expiryDate.addEventListener("change", function () {
        if (this.value) {
            expiryDuration.value = "";
        }
    });

    const today = new Date();
    const localToday = new Date(
            today.getTime() - today.getTimezoneOffset() * 60000
        ).toISOString().split("T")[0];
    expiryDate.min = localToday;

    function openEditModal(shortId, encodedURL) {
        const modal = document.getElementById("editModal");
        const editForm = document.getElementById("editForm");
        const destinationInput = document.getElementById("editDestination");

        destinationInput.value = decodeURIComponent(encodedURL);

        editForm.action = `/url/edit/${encodeURIComponent(shortId)}`;

        modal.style.display = "flex";
        destinationInput.focus();
    }
    function closeEditModal() {
        document.getElementById("editModal").style.display = "none";
    }
    
// Open the Edit Expiration modal
function openExpirationModal(shortId, currentExpiry) {

    const modal = document.getElementById("expirationModal");
    const form = document.getElementById("expirationForm");

    const durationInput = document.getElementById("editExpiryDuration");
    const dateInput = document.getElementById("editExpiryDate");

    // Set the correct backend route
    form.action = `/url/edit-expiration/${encodeURIComponent(shortId)}`;

    // Reset previous selections
    durationInput.value = "";
    dateInput.value = "";

    // Display the existing expiry date, if available
    if (currentExpiry) {
        const date = new Date(currentExpiry);

        const localDate = new Date(
            date.getTime() - date.getTimezoneOffset() * 60000
        ).toISOString().split("T")[0];

        dateInput.value = localDate;
    }

    // Set browser timezone
    document.getElementById("editTimezoneOffset").value =
        new Date().getTimezoneOffset();

    // Prevent selecting a past date
    const today = new Date();

    const localToday = new Date(
        today.getTime() - today.getTimezoneOffset() * 60000
    ).toISOString().split("T")[0];

    dateInput.min = localToday;

    modal.style.display = "flex";
}

// Close the Edit Expiration modal
function closeExpirationModal() {
    document.getElementById("expirationModal").style.display = "none";
}

// Keep preset duration and custom date mutually exclusive
document.getElementById("editExpiryDuration").addEventListener("change", function () {
    if (this.value) {
        document.getElementById("editExpiryDate").value = "";
    }
});

document.getElementById("editExpiryDate").addEventListener("change", function () {
    if (this.value) {
        document.getElementById("editExpiryDuration").value = "";
    }
});




    // Search URLs

// Search and Sort URLs

const searchInput = document.getElementById("searchLinks");
const sortSelect = document.getElementById("sortLinks");
const tableBody = document.getElementById("urlTableBody");

const originalRows = Array.from(
    document.querySelectorAll(".url-row")
);

// Store original order for recently created sorting
const originalOrder = new Map(
    originalRows.map((row, index) => [row, index])
);

function updateLinks() {

    const searchValue = searchInput.value.toLowerCase().trim();
    const sortValue = sortSelect.value;

    const rows = Array.from(originalRows);

    // Sorting
    rows.sort((a, b) => {

        const aClicks = Number(
            a.querySelector(".click-count").textContent.trim()
        );

        const bClicks = Number(
            b.querySelector(".click-count").textContent.trim()
        );

        const aName = a.querySelector(".short-link")
            .textContent.trim().toLowerCase();

        const bName = b.querySelector(".short-link")
            .textContent.trim().toLowerCase();

        switch (sortValue) {

            case "most":
                return bClicks - aClicks;

            case "least":
                return aClicks - bClicks;

            case "alphabetical":
                return aName.localeCompare(bName);

            case "recent":
            default:
                return Number(b.dataset.createdAt) - Number(a.dataset.createdAt);

        }

    });

    // Reorder rows in the table
    rows.forEach(row => tableBody.appendChild(row));

    // Search and display matching rows
    let visibleCount = 0;

    rows.forEach(row => {

        const rowText = row.innerText.toLowerCase();

        const matches = rowText.includes(searchValue);

        row.style.display = matches ? "" : "none";

        if (matches) {
            visibleCount++;
        }

    });

    // Update result count
    document.getElementById("searchCount").textContent =
        `Showing ${visibleCount} of ${rows.length} links`;

    document.getElementById("tableFooter").textContent =
        `Showing ${visibleCount} shortened links`;

    document.getElementById("noSearchResults").style.display =
        visibleCount === 0 && rows.length > 0 ? "block" : "none";

}

// Listen for search and sorting changes
searchInput.addEventListener("input", updateLinks);
sortSelect.addEventListener("change", updateLinks);
const dailyClicks = <%- JSON.stringify(dailyClicks || []) %>;

    const chartCanvas = document.getElementById("dashboardClicksChart");

    if (chartCanvas) {
        new Chart(chartCanvas, {
            type: "line",
            data: {
                labels: dailyClicks.map(item => item.date),
                datasets: [{
                    label: "Clicks",
                    data: dailyClicks.map(item => item.clicks),
                    borderColor: "#2563eb",
                    backgroundColor: "rgba(37, 99, 235, 0.10)",
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: "#2563eb"
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
    }
</script>
</body>
</html>
