
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Code | LinkShort</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            color: #172033;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .card {
            background: white;
            border: 1px solid #e8edf4;
            border-radius: 16px;
            padding: 35px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(15,23,42,.05);
            max-width: 440px;
            width: 100%;
        }

        .brand {
            color: #2563eb;
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 28px;
        }

        h1 {
            font-size: 23px;
            margin-bottom: 9px;
        }

        .description {
            color: #64748b;
            font-size: 13px;
            line-height: 1.6;
        }

        .qr-wrapper {
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 13px;
            padding: 15px;
            display: inline-block;
            margin: 25px 0 18px;
        }

        .qr-image {
            display: block;
            width: 230px;
            height: 230px;
            max-width: 100%;
            object-fit: contain;
        }

        .url {
            color: #2563eb;
            font-size: 13px;
            font-weight: 600;
            overflow-wrap: anywhere;
            line-height: 1.7;
            margin-bottom: 22px;
        }

        .actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .actions a {
            display: block;
            padding: 13px 18px;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: background .2s;
        }

        .actions a:hover { background: #1d4ed8; }

        .actions .secondary {
            background: #eff6ff;
            color: #2563eb;
        }

        .actions .secondary:hover { background: #dbeafe; }

        @media(max-width: 420px) {
            .card { padding: 25px 18px; }
            .qr-image { width: 200px; height: 200px; }
        }
    </style>
</head>

<body>
    <main class="card">
        <div class="brand">LinkShort.</div>

        <h1>Your QR Code</h1>
        <p class="description">
            Scan this QR code to open your shortened URL.
        </p>

        <div class="qr-wrapper">
            <img src="<%= qrCode %>" alt="QR Code for shortened URL" class="qr-image">
        </div>

        <p class="url" id="shortUrl">
            <%= `${baseURL.replace(/\/$/, '')}/${url.shortId}` %>
        </p>

        <div class="actions">
            <a href="<%= qrCode %>" download="LinkShort-<%= url.shortId %>.png">
                Download QR Code
            </a>

            <a href="/" class="secondary">
                Back to Dashboard
            </a>
        </div>
    </main>
</body>
</html>
