
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Analytics | LinkShort</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --primary: #2563eb;
            --background: #f8fafc;
            --surface: #fff;
            --text: #172033;
            --muted: #64748b;
            --border: #e8edf4;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--background);
            color: var(--text);
            padding: 35px 20px;
        }

        .container { max-width: 1100px; margin: auto; }

        .header { margin-bottom: 28px; }
        .header h1 { font-size: 27px; margin-bottom: 8px; }
        .header p { color: var(--muted); font-size: 13px; }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 20px;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 23px;
            margin-bottom: 20px;
            min-width: 0;
            box-shadow: 0 2px 8px rgba(15,23,42,.025);
        }

        .stat-label { color: var(--muted); font-size: 13px; }
        .stat-number {
            font-size: 30px;
            font-weight: 700;
            color: var(--primary);
            margin-top: 12px;
            overflow-wrap: anywhere;
        }

        .last-visited {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary);
            margin-top: 12px;
            overflow-wrap: anywhere;
        }

        .card h2 { font-size: 17px; margin-bottom: 7px; }
        .chart-description {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
            margin-top: 7px;
        }

        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
            margin-top: 20px;
        }

        select {
            padding: 11px 13px;
            border: 1px solid #dbe2ea;
            border-radius: 8px;
            background: white;
            font-family: inherit;
            font-size: 13px;
            margin-top: 15px;
        }

        .url {
            color: var(--primary);
            overflow-wrap: anywhere;
            margin-top: 10px;
            line-height: 1.7;
            font-size: 13px;
        }

        .url a { color: inherit; font-weight: 600; }

        .info-label {
            margin-top: 20px;
            font-weight: 600;
            font-size: 13px;
        }

        .history-item {
            padding: 15px 0;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            gap: 15px;
        }

        .history-item:last-child { border-bottom: none; }
        .visit-number { font-weight: 600; font-size: 13px; }
        .timestamp { color: var(--muted); font-size: 12px; }
        .empty { color: #94a3b8; padding: 20px 0; font-size: 13px; }

        .back-btn {
            display: inline-block;
            background: var(--primary);
            color: white;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        @media (max-width: 700px) {
            body { padding: 22px 14px; }
            .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
            .card { padding: 17px; }
            .stat-number { font-size: 25px; }
            .last-visited { font-size: 15px; }
            .chart-container { height: 250px; }
        }

        @media (max-width: 380px) {
            .stats { grid-template-columns: 1fr; }
            .history-item { flex-direction: column; gap: 6px; }
        }
    </style>
</head>

<body>
<div class="container">

    <div class="header">
        <h1>URL Analytics</h1>
        <p>Track the performance of your shortened URL.</p>
    </div>

    <div class="stats">
        <div class="card">
            <p class="stat-label">Total Clicks</p>
            <div class="stat-number"><%= totalClicks %></div>
        </div>

        <div class="card">
            <p class="stat-label">Short ID</p>
            <div class="stat-number"><%= url.shortId %></div>
        </div>

        <div class="card">
            <p class="stat-label">Last Visited</p>
            <div class="last-visited">
                <% if (url.visitHistory.length > 0) { %>
                    <%= new Date(url.visitHistory[url.visitHistory.length - 1].timestamp).toLocaleString() %>
                <% } else { %>
                    Never
                <% } %>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Click Performance</h2>
        <p class="chart-description" id="clickChartDescription">
            Track visits over the last 7 days.
        </p>

        <select id="clickRange" aria-label="Select click history range">
            <option value="7">Last 7 Days</option>
            <option value="30">Last 30 Days</option>
        </select>

        <div class="chart-container">
            <canvas id="clickChart"></canvas>
        </div>
    </div>

    <div class="stats">
        <div class="card">
            <h2>Device Breakdown</h2>
            <p class="chart-description">Devices visitors use to open your links.</p>
            <div class="chart-container"><canvas id="deviceChart"></canvas></div>
        </div>

        <div class="card">
            <h2>Browser Breakdown</h2>
            <p class="chart-description">Browsers visitors use to open your links.</p>
            <div class="chart-container"><canvas id="browserChart"></canvas></div>
        </div>
    </div>

    <div class="card">
        <h2>Traffic Sources</h2>
        <p class="chart-description">Understand where your link clicks are coming from.</p>
        <div class="chart-container"><canvas id="sourceChart"></canvas></div>
    </div>

    <div class="card">
        <h2>URL Information</h2>

        <p class="info-label">Original URL</p>
        <p class="url"><%= url.redirectURL %></p>

        <p class="info-label">Shortened URL</p>
        <p class="url">
            <a href="/<%= url.shortId %>" id="shortUrl">
                <%= url.shortId %>
            </a>
        </p>
    </div>

    <div class="card">
        <h2>Visit History</h2>

        <% if (url.visitHistory.length > 0) { %>
            <% url.visitHistory.slice().reverse().forEach((visit, index) => { %>
                <div class="history-item">
                    <span class="visit-number">Visit #<%= url.visitHistory.length - index %></span>
                    <span class="timestamp"><%= new Date(visit.timestamp).toLocaleString() %></span>
                </div>
            <% }) %>
        <% } else { %>
            <p class="empty">No visits recorded yet.</p>
        <% } %>
    </div>

    <a href="/" class="back-btn">← Back to Dashboard</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const visitHistory = <%- JSON.stringify(url.visitHistory.map(visit => visit.timestamp)) %>;
const analytics = <%- JSON.stringify(analytics) %>;

document.getElementById("shortUrl").textContent =
    window.location.origin + "/<%= url.shortId %>";

function getChartData(data) {
    const entries = Object.entries(data || {});
    if (!entries.length) return { labels: ["No data yet"], values: [0] };
    return {
        labels: entries.map(entry => entry[0]),
        values: entries.map(entry => entry[1])
    };
}

const clickRange = document.getElementById("clickRange");
const clickDescription = document.getElementById("clickChartDescription");
const labels = [];
const clickCounts = [];
const today = new Date();

function generateClickChart(days) {
    labels.length = 0;
    clickCounts.length = 0;

    for (let i = days - 1; i >= 0; i--) {
        const date = new Date(today);
        date.setDate(today.getDate() - i);

        const dateKey = `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;

        labels.push(date.toLocaleDateString("en-IN", {
            day: "numeric", month: "short"
        }));

        const count = visitHistory.filter(timestamp => {
            if (!timestamp) return false;
            const visitDate = new Date(timestamp);
            const visitKey = `${visitDate.getFullYear()}-${String(visitDate.getMonth()+1).padStart(2,'0')}-${String(visitDate.getDate()).padStart(2,'0')}`;
            return visitKey === dateKey;
        }).length;

        clickCounts.push(count);
    }

    clickChart.data.labels = labels;
    clickChart.data.datasets[0].data = clickCounts;
    clickChart.update();

    clickDescription.textContent =
        `Track visits over the last ${days} days.`;
}

const clickChart = new Chart(document.getElementById("clickChart"), {
    type: "bar",
    data: {
        labels: [],
        datasets: [{
            label: "Total Clicks",
            data: [],
            backgroundColor: "#2563eb",
            borderRadius: 7
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, ticks: { precision: 0 } }
        }
    }
});

generateClickChart(7);
clickRange.addEventListener("change", function() {
    generateClickChart(Number(this.value));
});

const chartColors = [
    "#2563eb", "#10b981", "#f59e0b",
    "#8b5cf6", "#ef4444", "#06b6d4", "#64748b"
];

function createDoughnutChart(elementId, data) {
    const chartData = getChartData(data);
    new Chart(document.getElementById(elementId), {
        type: "doughnut",
        data: {
            labels: chartData.labels,
            datasets: [{
                data: chartData.values,
                backgroundColor: chartColors,
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: "bottom" } }
        }
    });
}

createDoughnutChart("deviceChart", analytics.devices);
createDoughnutChart("browserChart", analytics.browsers);

const sourceData = getChartData(analytics.sources);

new Chart(document.getElementById("sourceChart"), {
    type: "bar",
    data: {
        labels: sourceData.labels,
        datasets: [{
            label: "Visits",
            data: sourceData.values,
            backgroundColor: "#2563eb",
            borderRadius: 7
        }]
    },
    options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            x: { beginAtZero: true, ticks: { precision: 0 } }
        }
    }
});
</script>
</body>
</html>
