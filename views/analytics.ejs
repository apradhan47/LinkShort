
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>URL Analytics | LinkShort</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f4f6fb;
            color: #1e293b;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: auto;
        }

        .header {
            margin-bottom: 30px;
        }

        .header h1 {
            color: #2563eb;
            margin-bottom: 8px;
        }

        .header p {
            color: #64748b;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 14px;
            margin-bottom: 22px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .stat-number {
            font-size: 36px;
            font-weight: 700;
            color: #2563eb;
            margin-top: 12px;
        }

        .stat-label {
            color: #64748b;
            font-size: 14px;
        }

        .url {
            color: #2563eb;
            overflow-wrap: anywhere;
            margin-top: 10px;
        }

        .history-item {
            padding: 18px 0;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            gap: 15px;
        }

        .history-item:last-child {
            border-bottom: none;
        }

        .visit-number {
            font-weight: 600;
        }

        .timestamp {
            color: #64748b;
            font-size: 14px;
        }

        .back-btn {
            display: inline-block;
            background: #2563eb;
            color: white;
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .empty {
            color: #94a3b8;
            padding: 20px 0;
        }

        .chart-container {
            position: relative;
            height: 320px;
            width: 100%;
            margin-top: 20px;
        }

        .chart-description {
            color: #64748b;
            font-size: 14px;
            margin-top: 8px;
        }

        .last-visited {
            font-size: 22px;
            font-weight: 700;
            color: #2563eb;
            margin-top: 12px;
        }

        @media(max-width: 600px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .history-item {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">
        <h1>URL Analytics</h1>
        <p>Track the performance of your shortened URL.</p>
    </div>

    <div class="stats">

        <div class="card">
            <p class="stat-label">Total Clicks</p>
            <div class="stat-number"><%= totalClicks %></div>
        </div>

        <div class="card">
            <p class="stat-label">Short ID</p>
            <div class="stat-number" style="font-size: 25px;">
                <%= url.shortId %>
            </div>
        </div>

        <div class="card">
            <p class="stat-label">Last Visited</p>

            <div class="last-visited">
                 <% if (url.visitHistory.length > 0) { %>
                    <%= new Date(
                        url.visitHistory[url.visitHistory.length - 1].timestamp
                    ).toLocaleString() %>
                <% } else { %> 
                    Never
                <% } %>
            </div>
        </div>

        <div class="card">
            <h2>Click Performance</h2>
            <p class="chart-description">
                Track how many times your shortened URL was visited over the last 7 days.
            </p>

            <div class="chart-container">
                <canvas id="clickChart"></canvas>
            </div>
        </div>

    </div>

    <div class="card">

        <h2>URL Information</h2>

        <p style="margin-top: 20px; font-weight: 600;">
            Original URL
        </p>

        <p class="url"><%= url.redirectURL %></p>

        <p style="margin-top: 20px; font-weight: 600;">
            Shortened URL
        </p>

        <p class="url">
            <a href="/<%= url.shortId %>">
                <%= `${typeof host !== 'undefined' ? host : 'http://localhost:8001'}/${url.shortId}` %>
            </a>
        </p>

    </div>

    <div class="card">

        <h2>Visit History</h2>

        <% if (url.visitHistory.length > 0) { %>

            <% url.visitHistory.slice().reverse().forEach((visit, index) => { %>

                <div class="history-item">

                    <span class="visit-number">
                        Visit #<%= url.visitHistory.length - index %>
                    </span>

                    <span class="timestamp">
                        <%= new Date(visit.timestamp).toLocaleString() %>
                    </span>

                </div>

            <% }) %>

        <% } else { %>

            <p class="empty">
                No visits recorded yet.
            </p>

        <% } %>

    </div>

    <a href="/" class="back-btn">
        ← Back to Dashboard
    </a>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Get visit timestamps from MongoDB through EJS
    const visitHistory = <%- JSON.stringify(
        url.visitHistory.map(visit => visit.timestamp)
    ) %>;

    // Generate the last 7 days, including today
    const labels = [];
    const clickCounts = [];

    const today = new Date();

    for (let i = 6; i >= 0; i--) {

        const date = new Date(today);

        date.setDate(today.getDate() - i);

        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');

        const dateKey = `${year}-${month}-${day}`;

        labels.push(
            date.toLocaleDateString('en-IN', {
                day: 'numeric',
                month: 'short'
            })
        );

        // Count visits for this particular day
        const count = visitHistory.filter(timestamp => {

            if (!timestamp) return false;

            const visitDate = new Date(timestamp);

            const visitKey =
                `${visitDate.getFullYear()}-${String(
                    visitDate.getMonth() + 1
                ).padStart(2, '0')}-${String(
                    visitDate.getDate()
                ).padStart(2, '0')}`;

            return visitKey === dateKey;

        }).length;

        clickCounts.push(count);
    }

    // Create the chart
    const ctx = document.getElementById('clickChart');

    new Chart(ctx, {

        type: 'bar',

        data: {
            labels: labels,

            datasets: [{
                label: 'Total Clicks',
                data: clickCounts,

                backgroundColor: '#3b82f6',
                borderRadius: 7,
                barThickness: 30
            }]
        },

        options: {

            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: false
                }
            },

            scales: {

                y: {
                    beginAtZero: true,

                    ticks: {
                        precision: 0
                    },

                    title: {
                        display: true,
                        text: 'Number of Clicks'
                    }
                },

                x: {
                    title: {
                        display: true,
                        text: 'Date'
                    }
                }

            }

        }

    });
</script>
</body>
</html>

